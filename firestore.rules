rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The owner, plus every active member in app_users (managed on the
    // admin page, same list the API checks). get() works even though
    // clients can't read app_users themselves.
    function isTeam() {
      return request.auth != null
        && request.auth.token.email != null
        && (
          request.auth.token.email.lower() == 'inderjeet.kumar8184@gmail.com'
          || get(/databases/$(database)/documents/app_users/$(request.auth.token.email.lower())).data.active == true
        );
    }

    // The dashboard reads these live in the browser (inbox, reply
    // notifications, broadcast progress). Every write goes through the
    // server's Admin SDK, which bypasses these rules.
    match /whatsapp_conversations/{docId} {
      allow read: if isTeam();
    }
    match /bulk_reports/{docId} {
      allow read: if isTeam();
    }

    // Everything else (contacts, credentials, tokens, logs, templates…):
    // no direct access from browsers or the public API key.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
