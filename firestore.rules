rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // The team's accounts. Keep in sync with ALLOWED_EMAILS in Vercel
    // (rules can't read environment variables).
    function isTeam() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'realhubbventures@gmail.com',
          'inderjeet.kumar8184@gmail.com'
        ];
    }

    // The dashboard reads these live in the browser (inbox, reply
    // notifications, broadcast progress). Every write goes through the
    // server's Admin SDK, which bypasses these rules.
    match /whatsapp_conversations/{docId} {
      allow read: if isTeam();
    }
    match /bulk_reports/{docId} {
      allow read: if isTeam();
    }

    // Everything else (contacts, credentials, tokens, logs, templates…):
    // no direct access from browsers or the public API key.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
