<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: B symbol on navy. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_light</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Shown while the Flutter engine starts (after the system splash exits):
         keep the logo on navy so there is no blank gap before the login hero. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
</resources>