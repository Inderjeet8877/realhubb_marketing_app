# ============================================================
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to git — it is in .gitignore.
# ============================================================

# Firebase Configuration (get from Firebase Console → Project Settings)
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id

# Meta / WhatsApp Cloud API (get from Meta Business Manager)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_ACCESS_TOKEN_1=your_permanent_access_token
WHATSAPP_PHONE_NUMBER_ID_1=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID_1=your_whatsapp_business_account_id

# Webhook verify token — choose any secret string
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_chosen_verify_token

# Public base URL of this deployment — used by backend broadcast jobs to call
# themselves (start → process → process → ... → done). Must be the real
# domain in production (e.g. https://www.realhubb.co.in), not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Random secret shared only between this app's own backend routes — guards
# /api/whatsapp/broadcasts/process so it can't be triggered by outside
# requests to spam sends on this account's Meta bill. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_SECRET=your_random_internal_secret
