# Copy to infra/.env and fill in. infra/.env is git-ignored — never commit it.

# Database roles (generate long random values, e.g. `openssl rand -base64 32`)
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# Signs session tokens (≥ 32 random bytes)
AUTH_JWT_SECRET=change-me-jwt-secret
# Encrypts stored WhatsApp access tokens. 32 random bytes: openssl rand -base64 32
# Back it up with the DB passwords; if it is lost, every workspace must be reconnected.
CREDENTIALS_KEY=

# Platform admin created on first run. Leave ADMIN_PASSWORD empty to generate
# one (printed once in `docker compose logs migrate`).
ADMIN_EMAIL=realhubbmktg@gmail.com
ADMIN_PASSWORD=

# true behind HTTPS (production); false for local http://localhost
COOKIE_SECURE=false

# Google OAuth client IDs allowed for "Continue with Google" (comma-separated:
# web client id, Android client id). Empty = Google sign-in disabled.
GOOGLE_CLIENT_IDS=
# The web OAuth client id again, for the browser's "Continue with Google" button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Browser config baked into the web build (copy from the repo-root .env.local)
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
